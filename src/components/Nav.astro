---
const currentPath = Astro.url.pathname;

const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];
---

<nav class="bg-white shadow-md sticky top-0 z-50" aria-label="Main navigation">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-28">
      <!-- Logo -->
      <a href="/" class="flex-shrink-0 flex items-center" aria-label="Expert Insurance Services, Inc. — Home">
        <img
          src="/logo.png"
          alt="Expert Insurance Services, Inc. logo"
          class="h-28 w-auto object-contain"
        />
      </a>

      <!-- Desktop nav links -->
      <div class="hidden md:flex items-center space-x-8">
        {navLinks.map(link => (
          <a
            href={link.href}
            class={`text-sm font-semibold tracking-wide uppercase transition-colors duration-200 ${
              currentPath === link.href
                ? 'text-brand-red border-b-2 border-brand-red pb-0.5'
                : 'text-brand-charcoal hover:text-brand-red'
            }`}
          >
            {link.label}
          </a>
        ))}
        <a
          href="tel:8189078189"
          class="ml-4 bg-brand-red text-white text-sm font-semibold px-5 py-2.5 rounded hover:bg-brand-red-dark transition-colors duration-200"
          aria-label="Call us at (818) 907-8189"
        >
          (818) 907-8189
        </a>
      </div>

      <!-- Mobile menu toggle -->
      <div class="md:hidden flex items-center">
        <button
          id="mobile-menu-btn"
          type="button"
          class="inline-flex items-center justify-center p-2 rounded-md text-brand-charcoal hover:text-brand-red focus:outline-none focus:ring-2 focus:ring-brand-red"
          aria-controls="mobile-menu"
          aria-expanded="false"
          aria-label="Toggle mobile menu"
        >
          <svg id="icon-open" class="block h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg id="icon-close" class="hidden h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-gray-100">
    <div class="px-4 pt-2 pb-4 space-y-1">
      {navLinks.map(link => (
        <a
          href={link.href}
          class={`block px-3 py-2.5 text-base font-semibold rounded-md transition-colors duration-200 ${
            currentPath === link.href
              ? 'text-brand-red bg-red-50'
              : 'text-brand-charcoal hover:text-brand-red hover:bg-gray-50'
          }`}
        >
          {link.label}
        </a>
      ))}
      <a
        href="tel:8189078189"
        class="block mt-2 text-center bg-brand-red text-white font-semibold px-4 py-3 rounded hover:bg-brand-red-dark transition-colors duration-200"
        aria-label="Call us at (818) 907-8189"
      >
        Call: (818) 907-8189
      </a>
    </div>
  </div>
</nav>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('icon-open');
  const iconClose = document.getElementById('icon-close');

  btn?.addEventListener('click', () => {
    const expanded = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', String(!expanded));
    menu?.classList.toggle('hidden');
    iconOpen?.classList.toggle('hidden');
    iconClose?.classList.toggle('hidden');
  });
</script>
