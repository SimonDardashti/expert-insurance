---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Independent Insurance Broker — Sherman Oaks, CA | Expert Insurance Services"
  description="Expert Insurance Services is an independent insurance agency in Sherman Oaks, CA. We help clients compare auto, home, life, health, commercial, and disability coverage options."
>

  <Nav />

  <!-- ============================
       HERO
  ============================= -->
  <section
    class="relative bg-brand-charcoal text-white overflow-hidden"
    aria-label="Hero"
    style="background-image: radial-gradient(ellipse at 70% 50%, rgba(185,28,28,0.12) 0%, transparent 60%), radial-gradient(ellipse at 20% 80%, rgba(255,255,255,0.03) 0%, transparent 50%);"
  >
    <!-- Subtle texture overlay -->
    <div class="absolute inset-0 opacity-5" style="background-image: url(&quot;data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='1'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E&quot;);" aria-hidden="true"></div>

    <div class="relative max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-24 md:py-36">
      <div class="max-w-3xl">
        <!-- Eyebrow -->
        <p class="text-brand-red font-semibold text-sm uppercase tracking-widest mb-4">
          Family-Owned &bull; Independent Broker &bull; Since 1981
        </p>

        <!-- Heading -->
        <h1 class="font-serif text-4xl sm:text-5xl lg:text-6xl font-bold leading-tight text-white mb-6">
          Protecting Southern California Families Since 1981
        </h1>

        <!-- Subheading -->
        <p class="text-gray-300 text-xl leading-relaxed mb-10 max-w-2xl">
          Founded by Shawn Dardashti in 1981, Expert Insurance Services, Inc. has been proudly serving Southern California families and businesses for over 45 years.
        </p>

        <!-- CTA -->
        <div class="flex flex-col sm:flex-row gap-4 items-start">
          <a
            href="tel:8189078189"
            class="inline-flex items-center gap-3 bg-brand-red hover:bg-brand-red-dark text-white font-bold text-lg px-8 py-4 rounded-lg transition-colors duration-200 shadow-lg"
            aria-label="Call Expert Insurance Services, Inc. at (818) 907-8189"
          >
            <svg class="w-5 h-5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            Call Us: (818) 907-8189
          </a>
        </div>

        <!-- Fine print -->
        <p class="mt-5 text-gray-400 text-sm">
          Independent broker — we shop multiple carriers to find your best rate.
        </p>
      </div>
    </div>
  </section>

  <!-- ============================
       SERVICES
  ============================= -->
  <section class="bg-brand-cream py-20 md:py-28" aria-labelledby="services-heading">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-14">
        <p class="text-brand-red font-semibold text-sm uppercase tracking-widest mb-3">Coverage Options</p>
        <h2 id="services-heading" class="font-serif text-4xl sm:text-5xl font-bold text-brand-charcoal">What We Cover</h2>
        <p class="mt-4 text-gray-600 text-lg max-w-xl mx-auto">
          From personal protection to business coverage, we offer comprehensive insurance solutions tailored to your needs.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">

        <!-- Auto -->
        <div class="bg-white rounded-xl shadow-sm border-t-4 border-brand-red p-6 hover:-translate-y-1 hover:shadow-md transition-all duration-200">
          <div class="mb-4">
            <svg class="w-10 h-10 text-brand-red" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 18.75a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 01-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 00-3.213-9.193 2.056 2.056 0 00-1.58-.86H14.25M16.5 18.75h-2.25m0-11.177v-.958c0-.568-.422-1.048-.987-1.106a48.554 48.554 0 00-10.026 0 1.106 1.106 0 00-.987 1.106v7.635m12-6.677v6.677m0 4.5v-4.5m0 0h-12" />
            </svg>
          </div>
          <h3 class="font-bold text-brand-charcoal text-lg mb-1">Auto Insurance</h3>
          <p class="text-gray-500 text-sm leading-relaxed">Full coverage, liability, and more — we find the best rate for your vehicle.</p>
        </div>

        <!-- Home -->
        <div class="bg-white rounded-xl shadow-sm border-t-4 border-brand-red p-6 hover:-translate-y-1 hover:shadow-md transition-all duration-200">
          <div class="mb-4">
            <svg class="w-10 h-10 text-brand-red" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12l8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25" />
            </svg>
          </div>
          <h3 class="font-bold text-brand-charcoal text-lg mb-1">Home Insurance</h3>
          <p class="text-gray-500 text-sm leading-relaxed">Protect your home and belongings with the right homeowners policy.</p>
        </div>

        <!-- Life -->
        <div class="bg-white rounded-xl shadow-sm border-t-4 border-brand-red p-6 hover:-translate-y-1 hover:shadow-md transition-all duration-200">
          <div class="mb-4">
            <svg class="w-10 h-10 text-brand-red" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z" />
            </svg>
          </div>
          <h3 class="font-bold text-brand-charcoal text-lg mb-1">Life Insurance</h3>
          <p class="text-gray-500 text-sm leading-relaxed">Secure your family's financial future with term or whole life coverage.</p>
        </div>

        <!-- Health -->
        <div class="bg-white rounded-xl shadow-sm border-t-4 border-brand-red p-6 hover:-translate-y-1 hover:shadow-md transition-all duration-200">
          <div class="mb-4">
            <svg class="w-10 h-10 text-brand-red" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h3.75M9 15h3.75M9 18h3.75m3 .75H18a2.25 2.25 0 002.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 00-1.123-.08m-5.801 0c-.065.21-.1.433-.1.664 0 .414.336.75.75.75h4.5a.75.75 0 00.75-.75 2.25 2.25 0 00-.1-.664m-5.8 0A2.251 2.251 0 0113.5 2.25H15c1.012 0 1.867.668 2.15 1.586m-5.8 0c-.376.023-.75.05-1.124.08C9.095 4.01 8.25 4.973 8.25 6.108V8.25m0 0H4.875c-.621 0-1.125.504-1.125 1.125v11.25c0 .621.504 1.125 1.125 1.125h9.75c.621 0 1.125-.504 1.125-1.125V9.375c0-.621-.504-1.125-1.125-1.125H8.25zM6.75 12h.008v.008H6.75V12zm0 3h.008v.008H6.75V15zm0 3h.008v.008H6.75V18z" />
            </svg>
          </div>
          <h3 class="font-bold text-brand-charcoal text-lg mb-1">Health Insurance</h3>
          <p class="text-gray-500 text-sm leading-relaxed">Individual and family health plans — we help you navigate your options.</p>
        </div>

        <!-- Commercial -->
        <div class="bg-white rounded-xl shadow-sm border-t-4 border-brand-red p-6 hover:-translate-y-1 hover:shadow-md transition-all duration-200">
          <div class="mb-4">
            <svg class="w-10 h-10 text-brand-red" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 21h16.5M4.5 3h15M5.25 3v18m13.5-18v18M9 6.75h1.5m-1.5 3h1.5m-1.5 3h1.5m3-6H15m-1.5 3H15m-1.5 3H15M9 21v-3.375c0-.621.504-1.125 1.125-1.125h3.75c.621 0 1.125.504 1.125 1.125V21" />
            </svg>
          </div>
          <h3 class="font-bold text-brand-charcoal text-lg mb-1">Commercial Insurance</h3>
          <p class="text-gray-500 text-sm leading-relaxed">Comprehensive business coverage including liability, property, and more.</p>
        </div>

        <!-- Dental -->
        <div class="bg-white rounded-xl shadow-sm border-t-4 border-brand-red p-6 hover:-translate-y-1 hover:shadow-md transition-all duration-200">
          <div class="mb-4">
            <svg class="w-10 h-10 text-brand-red" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M11.48 3.499a.562.562 0 011.04 0l2.125 5.111a.563.563 0 00.475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 00-.182.557l1.285 5.385a.562.562 0 01-.84.61l-4.725-2.885a.563.563 0 00-.586 0L6.982 20.54a.562.562 0 01-.84-.61l1.285-5.386a.562.562 0 00-.182-.557l-4.204-3.602a.563.563 0 01.321-.988l5.518-.442a.563.563 0 00.475-.345L11.48 3.5z" />
            </svg>
          </div>
          <h3 class="font-bold text-brand-charcoal text-lg mb-1">Dental Insurance</h3>
          <p class="text-gray-500 text-sm leading-relaxed">Keep your smile protected with affordable individual and family dental plans.</p>
        </div>

        <!-- Disability -->
        <div class="bg-white rounded-xl shadow-sm border-t-4 border-brand-red p-6 hover:-translate-y-1 hover:shadow-md transition-all duration-200">
          <div class="mb-4">
            <svg class="w-10 h-10 text-brand-red" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" />
            </svg>
          </div>
          <h3 class="font-bold text-brand-charcoal text-lg mb-1">Disability Insurance</h3>
          <p class="text-gray-500 text-sm leading-relaxed">Protect your income if illness or injury prevents you from working.</p>
        </div>

        <!-- CTA card -->
        <div class="bg-brand-red rounded-xl p-6 flex flex-col justify-center items-start hover:-translate-y-1 hover:shadow-md transition-all duration-200">
          <h3 class="font-bold text-white text-lg mb-2">Not sure what you need?</h3>
          <p class="text-red-100 text-sm leading-relaxed mb-4">Call us and we'll help you find the right coverage at the best price.</p>
          <a
            href="tel:8189078189"
            class="inline-flex items-center gap-2 bg-white text-brand-red font-bold text-sm px-4 py-2 rounded hover:bg-red-50 transition-colors duration-200"
            aria-label="Call (818) 907-8189"
          >
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            (818) 907-8189
          </a>
        </div>

      </div>
    </div>
  </section>

  <!-- ============================
       WHY CHOOSE US
  ============================= -->
  <section class="bg-white py-20 md:py-28" aria-labelledby="why-heading">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-14">
        <p class="text-brand-red font-semibold text-sm uppercase tracking-widest mb-3">Why Expert Insurance</p>
        <h2 id="why-heading" class="font-serif text-4xl sm:text-5xl font-bold text-brand-charcoal">Why Choose Us</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-10">

        <!-- Independent Broker -->
        <div class="text-center">
          <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-red-50 mb-5">
            <svg class="w-8 h-8 text-brand-red" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" />
            </svg>
          </div>
          <h3 class="font-serif text-2xl font-bold text-brand-charcoal mb-3">Independent Broker</h3>
          <p class="text-gray-600 leading-relaxed">
            We're not tied to any single insurance company. As an independent broker, we shop multiple carriers to compare rates and find you the best coverage at the best price — every time.
          </p>
        </div>

        <!-- Since 1981 -->
        <div class="text-center">
          <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-red-50 mb-5">
            <span class="font-serif text-xl font-bold text-brand-red" aria-hidden="true">'81</span>
          </div>
          <h3 class="font-serif text-2xl font-bold text-brand-charcoal mb-3">Established 1981</h3>
          <p class="text-gray-600 leading-relaxed">
            Over 45 years of serving Southern California. Our long-standing relationships with top carriers mean better access, faster claims support, and the experience to navigate even complex coverage needs.
          </p>
        </div>

        <!-- Family Owned -->
        <div class="text-center">
          <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-red-50 mb-5">
            <svg class="w-8 h-8 text-brand-red" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12l8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25" />
            </svg>
          </div>
          <h3 class="font-serif text-2xl font-bold text-brand-charcoal mb-3">Family Owned</h3>
          <p class="text-gray-600 leading-relaxed">
            Founded in 1981, Expert Insurance Services, Inc. has been built on honesty, loyalty, and personal service. When you call us, you speak with someone who genuinely cares about protecting your family.
          </p>
        </div>

      </div>
    </div>
  </section>

  <!-- ============================
       CARRIERS
  ============================= -->
  <section class="bg-brand-cream py-16 md:py-20" aria-labelledby="carriers-heading">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-10">
        <p class="text-brand-red font-semibold text-sm uppercase tracking-widest mb-3">Our Partners</p>
        <h2 id="carriers-heading" class="font-serif text-3xl sm:text-4xl font-bold text-brand-charcoal">Our Trusted Carriers</h2>
        <p class="mt-3 text-gray-600">We work with leading insurers to give you the most competitive options.</p>
      </div>

      <div class="flex flex-wrap items-center justify-center gap-0">
        <span class="font-serif text-2xl sm:text-3xl text-gray-400 font-bold px-6 py-3">Mercury</span>
        <span class="text-gray-300 text-3xl hidden sm:inline" aria-hidden="true">&bull;</span>
        <span class="font-serif text-2xl sm:text-3xl text-gray-400 font-bold px-6 py-3">Travelers</span>
        <span class="text-gray-300 text-3xl hidden sm:inline" aria-hidden="true">&bull;</span>
        <span class="font-serif text-2xl sm:text-3xl text-gray-400 font-bold px-6 py-3">Safeco</span>
        <span class="text-gray-300 text-3xl hidden sm:inline" aria-hidden="true">&bull;</span>
        <span class="font-serif text-2xl sm:text-3xl text-gray-400 font-bold px-6 py-3">Bristol West</span>
        <span class="text-gray-300 text-3xl hidden sm:inline" aria-hidden="true">&bull;</span>
        <span class="font-serif text-2xl sm:text-3xl text-gray-400 font-bold px-6 py-3">Pacific Coastal</span>
      </div>
    </div>
  </section>

  <!-- ============================
       ABOUT TEASER
  ============================= -->
  <section class="bg-white py-20 md:py-28" aria-labelledby="about-teaser-heading">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center">

        <!-- Left: Icon -->
        <div class="flex flex-col items-center text-center">
          <div
            class="w-36 h-36 rounded-full bg-brand-red flex items-center justify-center mb-5 shadow-lg"
            aria-hidden="true"
          >
            <svg class="w-16 h-16 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M18 18.72a9.094 9.094 0 003.741-.479 3 3 0 00-4.682-2.72m.94 3.198l.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0112 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 016 18.719m12 0a5.971 5.971 0 00-.941-3.197m0 0A5.995 5.995 0 0012 12.75a5.995 5.995 0 00-5.058 2.772m0 0a3 3 0 00-4.681 2.72 8.986 8.986 0 003.74.477m.94-3.197a5.971 5.971 0 00-.94 3.197M15 6.75a3 3 0 11-6 0 3 3 0 016 0zm6 3a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0zm-13.5 0a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0z" />
            </svg>
          </div>
          <p class="text-gray-500 text-sm font-medium">Independent Insurance Broker</p>
          <p class="text-gray-400 text-sm">Sherman Oaks, CA · Est. 1981</p>
          <a
            href="tel:8189078189"
            class="mt-5 inline-flex items-center gap-2 bg-brand-red text-white font-semibold px-6 py-3 rounded-lg hover:bg-brand-red-dark transition-colors duration-200"
            aria-label="Call Expert Insurance Services, Inc. at (818) 907-8189"
          >
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            Call Us
          </a>
        </div>

        <!-- Right: Text -->
        <div>
          <p class="text-brand-red font-semibold text-sm uppercase tracking-widest mb-3">We Can Help</p>
          <h2 id="about-teaser-heading" class="font-serif text-4xl font-bold text-brand-charcoal mb-5">
            We Can Help
          </h2>
          <p class="text-gray-600 leading-relaxed mb-6">
            Whether you need coverage for your home, auto, business, or family, our team is here to help you understand your options and find the right insurance solutions for your needs.
          </p>
          <a
            href="/about"
            class="inline-flex items-center gap-1 text-brand-red font-semibold hover:text-brand-red-dark transition-colors duration-200"
          >
            Learn more about us
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
        </div>

      </div>
    </div>
  </section>

  <!-- ============================
       SERVICE AREA
  ============================= -->
  <section class="bg-white py-20 md:py-28" aria-labelledby="service-area-heading">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <p class="text-brand-red font-semibold text-sm uppercase tracking-widest mb-3">Where We Serve</p>
        <h2 id="service-area-heading" class="font-serif text-4xl sm:text-5xl font-bold text-brand-charcoal">
          Serving the San Fernando Valley &amp; Beyond
        </h2>
        <p class="mt-4 text-gray-600 text-lg max-w-2xl mx-auto">
          Based in Sherman Oaks, we proudly serve families and businesses across Los Angeles County and the greater Southern California area.
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 items-start">

        <!-- Map -->
        <div class="rounded-2xl overflow-hidden shadow-md border border-gray-100 h-80 lg:h-full min-h-80">
          <iframe
