---
import '../styles/global.css';

export interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Expert Insurance Services, Inc. — Independent insurance broker serving Southern California since 1981. Auto, Home, Life, Health, Commercial, Dental, and Disability insurance. Call (818) 907-8189."
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#B91C1C" />
    <link rel="icon" type="image/png" href="/logo.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <title>{title} | Expert Insurance Services, Inc.</title>

    <!-- JSON-LD Structured Data: InsuranceAgency (conservative, accurate business info only) -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "InsuranceAgency",
      "name": "Expert Insurance Services, Inc.",
      "url": "https://ex45.com",
      "logo": "https://ex45.com/logo.png",
      "description": "Independent insurance broker serving Southern California since 1981. Auto, home, life, health, commercial, dental, and disability insurance.",
      "telephone": "+18189078189",
      "email": "Ex1@sbcglobal.net",
      "foundingDate": "1981",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "15145 Ventura Blvd",
        "addressLocality": "Sherman Oaks",
        "addressRegion": "CA",
        "postalCode": "91403",
        "addressCountry": "US"
      },
      "openingHoursSpecification": [
        {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday"],
          "opens": "09:00",
          "closes": "17:00"
        }
      ],
      "areaServed": [
        "Sherman Oaks, CA", "Encino, CA", "Tarzana, CA", "Woodland Hills, CA",
        "Calabasas, CA", "Van Nuys, CA", "Studio City, CA", "Burbank, CA",
        "North Hollywood, CA", "Reseda, CA", "Chatsworth, CA", "Granada Hills, CA"
      ]
    }
    </script>
  </head>
  <body class="font-sans bg-white text-brand-charcoal antialiased">
    <slot />
  </body>
</html>
