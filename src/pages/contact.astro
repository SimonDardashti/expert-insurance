---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Contact"
  description="Contact Expert Insurance Services in Sherman Oaks, CA. Call Shawn Dardashti at (818) 907-8189. Located at 14500 Ventura Blvd. Mon–Fri 9am–5pm."
>

  <Nav />

  <!-- ============================
       PAGE HERO
  ============================= -->
  <section
    class="bg-brand-charcoal text-white py-20 md:py-28"
    style="background-image: radial-gradient(ellipse at 70% 50%, rgba(185,28,28,0.12) 0%, transparent 60%);"
    aria-label="Page header"
  >
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-brand-red font-semibold text-sm uppercase tracking-widest mb-3">We're Here to Help</p>
      <h1 class="font-serif text-4xl sm:text-5xl lg:text-6xl font-bold text-white max-w-2xl leading-tight">
        Get In Touch
      </h1>
      <p class="mt-5 text-gray-300 text-xl max-w-xl leading-relaxed">
        Call Shawn directly — no phone trees, no hold music. Just straightforward, personal service from a family broker who cares.
      </p>
    </div>
  </section>

  <!-- ============================
       MAIN CONTACT CONTENT
  ============================= -->
  <section class="bg-brand-cream py-20 md:py-28" aria-labelledby="contact-main-heading">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">

        <!-- Left Column: Contact Details -->
        <div>
          <p class="text-brand-red font-semibold text-sm uppercase tracking-widest mb-3">Reach Us Directly</p>
          <h2 id="contact-main-heading" class="font-serif text-4xl font-bold text-brand-charcoal mb-8">
            Call Shawn Directly
          </h2>

          <!-- Phone CTA -->
          <div class="bg-white rounded-2xl p-8 shadow-sm mb-6">
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 bg-brand-red rounded-full flex items-center justify-center flex-shrink-0">
                <svg class="w-6 h-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                </svg>
              </div>
              <div>
                <p class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-1">Phone</p>
                <a
                  href="tel:8189078189"
                  class="font-serif text-3xl font-bold text-brand-charcoal hover:text-brand-red transition-colors duration-200"
                  aria-label="Call (818) 907-8189"
                >
                  (818) 907-8189
                </a>
                <p class="text-gray-500 text-sm mt-2">
                  Best way to reach us. Shawn answers personally during business hours.
                </p>
                <a
                  href="tel:8189078189"
                  class="mt-4 inline-flex items-center gap-2 bg-brand-red text-white font-bold px-6 py-3 rounded-lg hover:bg-brand-red-dark transition-colors duration-200"
                  aria-label="Tap to call (818) 907-8189"
                >
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                  </svg>
                  Tap to Call
                </a>
              </div>
            </div>
          </div>

          <!-- Email -->
          <div class="bg-white rounded-2xl p-8 shadow-sm mb-6">
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 bg-red-50 rounded-full flex items-center justify-center flex-shrink-0">
                <svg class="w-6 h-6 text-brand-red" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
              </div>
              <div>
                <p class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-1">Email</p>
                <a
                  href="mailto:Ex1@sbcglobal.net"
                  class="text-xl font-bold text-brand-charcoal hover:text-brand-red transition-colors duration-200 break-all"
                >
                  Ex1@sbcglobal.net
                </a>
                <p class="text-gray-500 text-sm mt-2">
                  Send us an email and we'll get back to you as soon as possible.
                </p>
              </div>
            </div>
          </div>

          <!-- Address -->
          <div class="bg-white rounded-2xl p-8 shadow-sm">
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 bg-red-50 rounded-full flex items-center justify-center flex-shrink-0">
                <svg class="w-6 h-6 text-brand-red" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
              </div>
              <div>
                <p class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-1">Office Address</p>
                <address class="not-italic text-xl font-bold text-brand-charcoal leading-snug">
                  14500 Ventura Blvd<br />
                  Sherman Oaks, CA 91403
                </address>
                <a
                  href="https://www.google.com/maps/search/?api=1&query=14500+Ventura+Blvd+Sherman+Oaks+CA+91403"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="mt-3 inline-flex items-center gap-1 text-brand-red font-semibold text-sm hover:text-brand-red-dark transition-colors duration-200"
                  aria-label="Open in Google Maps (opens in new tab)"
                >
                  Open in Google Maps
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                  </svg>
                </a>
              </div>
            </div>
          </div>
        </div>

        <!-- Right Column: Hours + Map + Note -->
        <div class="flex flex-col gap-6">

          <!-- Hours Card -->
          <div class="bg-white rounded-2xl p-8 shadow-sm">
            <div class="flex items-center gap-3 mb-6">
              <div class="w-10 h-10 bg-red-50 rounded-full flex items-center justify-center">
                <svg class="w-5 h-5 text-brand-red" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              </div>
              <h3 class="font-serif text-2xl font-bold text-brand-charcoal">Business Hours</h3>
            </div>
            <div class="space-y-3">
              <div class="flex justify-between items-center py-2 border-b border-gray-100">
                <span class="font-semibold text-brand-charcoal">Monday</span>
                <span class="text-gray-600">9:00am – 5:00pm</span>
              </div>
              <div class="flex justify-between items-center py-2 border-b border-gray-100">
                <span class="font-semibold text-brand-charcoal">Tuesday</span>
                <span class="text-gray-600">9:00am – 5:00pm</span>
              </div>
              <div class="flex justify-between items-center py-2 border-b border-gray-100">
                <span class="font-semibold text-brand-charcoal">Wednesday</span>
                <span class="text-gray-600">9:00am – 5:00pm</span>
              </div>
              <div class="flex justify-between items-center py-2 border-b border-gray-100">
                <span class="font-semibold text-brand-charcoal">Thursday</span>
                <span class="text-gray-600">9:00am – 5:00pm</span>
              </div>
              <div class="flex justify-between items-center py-2 border-b border-gray-100">
                <span class="font-semibold text-brand-charcoal">Friday</span>
                <span class="text-gray-600">9:00am – 5:00pm</span>
              </div>
              <div class="flex justify-between items-center py-2 border-b border-gray-100">
                <span class="font-semibold text-brand-charcoal">Saturday</span>
                <span class="text-gray-600 italic">By appointment</span>
              </div>
              <div class="flex justify-between items-center py-2">
                <span class="font-semibold text-brand-charcoal">Sunday</span>
                <span class="text-gray-400">Closed</span>
              </div>
            </div>
          </div>

          <!-- Google Maps embed area -->
          <div class="bg-white rounded-2xl shadow-sm overflow-hidden">
            <div class="bg-gray-100 h-48 flex items-center justify-center relative">
              <div class="text-center z-10">
                <svg class="w-10 h-10 text-brand-red mx-auto mb-2" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
                </svg>
                <p class="text-gray-600 font-semibold text-sm">14500 Ventura Blvd</p>
                <p class="text-gray-500 text-xs">Sherman Oaks, CA 91403</p>
              </div>
            </div>
            <div class="p-5">
              <a
                href="https://www.google.com/maps/search/?api=1&query=14500+Ventura+Blvd+Sherman+Oaks+CA+91403"
                target="_blank"
                rel="noopener noreferrer"
                class="w-full flex items-center justify-center gap-2 bg-brand-charcoal text-white font-semibold px-5 py-3 rounded-lg hover:bg-gray-800 transition-colors duration-200"
                aria-label="Get directions on Google Maps (opens in new tab)"
              >
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
                Get Directions
              </a>
            </div>
          </div>

          <!-- Independent Broker Note -->
          <div class="bg-brand-red rounded-2xl p-6 text-white">
            <div class="flex items-start gap-3">
              <svg class="w-6 h-6 flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              <div>
                <h3 class="font-bold text-white mb-2">Why Call an Independent Broker?</h3>
                <p class="text-red-100 text-sm leading-relaxed">
                  As an independent broker, we'll shop multiple carriers to find you the best rate and coverage — not just what's most profitable for us. One call to us equals quotes from Mercury, Travelers, Safeco, Bristol West, Pacific Coastal, and more.
                </p>
              </div>
            </div>
          </div>

        </div>

      </div>
    </div>
  </section>

  <!-- ============================
       SERVING SOCAL
  ============================= -->
  <section class="bg-white py-14 border-t border-gray-100" aria-label="Service area">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <p class="text-gray-500 text-sm font-semibold uppercase tracking-widest mb-2">Service Area</p>
      <h2 class="font-serif text-3xl font-bold text-brand-charcoal mb-4">Serving All of Southern California</h2>
      <p class="text-gray-600 max-w-2xl mx-auto leading-relaxed">
        While our office is located in Sherman Oaks, we proudly serve clients throughout the greater Los Angeles area and all of Southern California. Call us regardless of where you are in SoCal — we're here to help.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-3 text-sm text-gray-500">
        {['Sherman Oaks', 'Encino', 'Studio City', 'Van Nuys', 'North Hollywood', 'Burbank', 'Glendale', 'Los Angeles', 'Woodland Hills', 'Tarzana', 'Reseda', 'Canoga Park'].map(city => (
          <span class="bg-brand-cream px-3 py-1.5 rounded-full">{city}</span>
        ))}
        <span class="bg-brand-cream px-3 py-1.5 rounded-full">and more...</span>
      </div>
    </div>
  </section>

  <!-- ============================
       BOTTOM CTA STRIP
  ============================= -->
  <section class="bg-brand-charcoal py-14" aria-label="Call to action">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="font-serif text-3xl sm:text-4xl font-bold text-white mb-4">
        Ready to Get a Quote?
      </h2>
      <p class="text-gray-300 text-lg mb-8">
        Call us today — no forms, no wait. Just real answers from a real person.
      </p>
      <a
        href="tel:8189078189"
        class="inline-flex items-center gap-3 bg-brand-red text-white font-bold text-xl px-10 py-5 rounded-lg hover:bg-brand-red-dark transition-colors duration-200 shadow-lg"
        aria-label="Call Expert Insurance Services at (818) 907-8189"
      >
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
        </svg>
        (818) 907-8189
      </a>
      <p class="mt-4 text-gray-500 text-sm">Mon–Fri 9am–5pm &bull; Sat by appointment</p>
    </div>
  </section>

  <Footer />

</Layout>
